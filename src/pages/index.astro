---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alfonso — Engineer & Developer</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #ffffff;
        --text: #111111;
        --muted: #888888;
        --border: #e5e5e5;
        --accent: #2563eb;
        --surface: #f9f9f9;
      }

      [data-theme="dark"] {
        --bg: #1B2936;
        --text: #E2E8F0;
        --muted: #8E9FB1;
        --border: #334155;
        --accent: #60a5fa;
        --surface: #253341;
      }

      body {
        font-family: system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        font-size: 15px;
        line-height: 1.6;
        transition: background 0.3s, color 0.3s;
      }

      a { color: inherit; text-decoration: none; }


      .theme-checkbox {
        --toggle-size: 8px;
        -webkit-appearance: none;
        appearance: none;
        width: 6.25em;
        height: 3.125em;
        background: linear-gradient(to right, #efefef 50%, #2a2a2a 50%) no-repeat;
        background-size: 205%;
        background-position: 0;
        transition: 0.4s;
        border-radius: 99em;
        position: relative;
        cursor: pointer;
        font-size: var(--toggle-size);
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      }

      .theme-checkbox::before {
        content: "";
        width: 2.25em;
        height: 2.25em;
        position: absolute;
        top: 0.438em;
        left: 0.438em;
        background: linear-gradient(to right, #efefef 50%, #2a2a2a 50%) no-repeat;
        background-size: 205%;
        background-position: 100%;
        border-radius: 50%;
        transition: 0.4s;
      }

      .theme-checkbox:checked::before {
        left: calc(100% - 2.25em - 0.438em);
        background-position: 0;
      }

      .theme-checkbox:checked { background-position: 100%; }

      [data-theme="dark"] .theme-checkbox { background-position: 100%; }
      [data-theme="dark"] .theme-checkbox::before {
        left: calc(100% - 2.25em - 0.438em);
        background-position: 0;
      }

      /* NAV */
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 2rem;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: var(--bg);
        z-index: 10;
        transition: background 0.3s;
      }
      .nav-logo { font-size: 15px; font-weight: 600; letter-spacing: -0.3px; }
      .nav-links { display: flex; gap: 1.5rem; align-items: center; }
      .nav-links a { font-size: 13px; color: var(--muted); transition: color 0.15s; }
      .nav-links a:hover { color: var(--text); }
      .nav-cta { font-size: 13px; font-weight: 500; color: var(--accent) !important; }

      /* HERO */
      .hero {
        padding: 6rem 2rem 5rem;
        border-bottom: 1px solid var(--border);
        max-width: 720px;
      }
      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.08em;
        color: var(--muted);
        text-transform: uppercase;
        margin-bottom: 1.25rem;
      }
      .hero h1 {
        font-size: 40px;
        font-weight: 500;
        letter-spacing: -1px;
        line-height: 1.1;
        margin-bottom: 1rem;
      }
      .hero p {
        font-size: 15px;
        color: var(--muted);
        max-width: 420px;
        margin-bottom: 2rem;
        line-height: 1.7;
      }
      .hero-actions { display: flex; gap: 12px; align-items: center; }
      .btn {
        font-size: 13px;
        font-weight: 500;
        padding: 9px 18px;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid var(--text);
        background: var(--text);
        color: var(--bg);
        transition: opacity 0.15s;
      }
      .btn:hover { opacity: 0.85; }
      .btn-ghost {
        background: transparent;
        color: var(--muted);
        border-color: var(--border);
      }
      .btn-ghost:hover { color: var(--text); border-color: var(--text); }

      /* SECTIONS */
      .section { padding: 3rem 2rem; border-bottom: 1px solid var(--border); }
      .section-label {
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--muted);
        text-transform: uppercase;
        margin-bottom: 1.5rem;
      }
      .section h2 {
        font-size: 22px;
        font-weight: 500;
        letter-spacing: -0.3px;
        margin-bottom: 0.5rem;
      }
      .section-sub {
        font-size: 14px;
        color: var(--muted);
        max-width: 420px;
        margin-bottom: 2rem;
        line-height: 1.7;
      }

      /* PROJECTS GRID */
      .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
      }
      .project-card {
        padding: 1.25rem;
        background: var(--surface);
        border-right: 1px solid var(--border);
        transition: background 0.15s;
      }
      .project-card:last-child { border-right: none; }
      .project-card:hover { background: var(--bg); }
      .project-tag {
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 999px;
        display: inline-block;
        margin-bottom: 0.75rem;
        background: #eff6ff;
        color: #2563eb;
      }
      .project-tag.amber { background: #fffbeb; color: #d97706; }
      .project-tag.green { background: #f0fdf4; color: #16a34a; }
      .project-name { font-size: 14px; font-weight: 500; margin-bottom: 0.4rem; }
      .project-desc { font-size: 12px; color: var(--muted); line-height: 1.5; }

      /* STACK */
      .stack-row { display: flex; flex-wrap: wrap; gap: 8px; }
      .pill {
        font-size: 12px;
        padding: 5px 12px;
        border-radius: 999px;
        border: 1px solid var(--border);
        color: var(--muted);
        background: var(--surface);
      }

      /* ABOUT */
      .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
      .stat-num { font-size: 28px; font-weight: 500; letter-spacing: -0.5px; }
      .stat-label { font-size: 13px; color: var(--muted); margin-top: 2px; }
      .about-bio { font-size: 14px; color: var(--muted); line-height: 1.7; }
      .divider-left { padding-left: 1.5rem; border-left: 1px solid var(--border); }

      /* CONTACT */
      .contact-links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 1.5rem; }
      .contact-link {
        font-size: 13px;
        color: var(--muted);
        padding: 7px 14px;
        border: 1px solid var(--border);
        border-radius: 6px;
        transition: all 0.15s;
      }
      .contact-link:hover { color: var(--text); border-color: var(--text); }

      /* FOOTER */
      footer {
        padding: 1.5rem 2rem;
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: var(--muted);
      }

      @media (max-width: 600px) {
        .hero h1 { font-size: 28px; }
        .about-grid { grid-template-columns: 1fr; }
        .nav-links { gap: 1rem; }
        .divider-left { padding-left: 0; border-left: none; border-top: 1px solid var(--border); padding-top: 1.5rem; }
      }
    </style>
  </head>
  <body>

    <nav>
      <span class="nav-logo">Alfonso</span>
      <div class="nav-links">
        <a href="#projects">Projects</a>
        <a href="#writing">Writing</a>
        <a href="#about">About</a>
        <a href="#contact" class="nav-cta">Contact →</a>
        <input type="checkbox" class="theme-checkbox" id="themeToggle" />
      </div>
    </nav>

    <section class="hero">
      <p class="eyebrow">Engineer & Developer · Surabaya, ID</p>
      <h1>Building systems,<br/>from silicon to screen.</h1>
      <p>Hardware engineer and developer. Currently going down the rabbit hole of bare-metal systems — bootloaders, Linux internals, and Android security.</p>
      <div class="hero-actions">
        <a href="#projects" class="btn">View projects</a>
        <a href="#writing" class="btn btn-ghost">Read my writing →</a>
      </div>
    </section>

    <section class="section" id="projects">
      <p class="section-label">Selected work</p>
      <h2>Projects</h2>
      <p class="section-sub">From creator platforms to embedded systems — things I've built and shipped.</p>
      <div class="projects-grid">
        <div class="project-card">
          <span class="project-tag">Web · Full-stack</span>
          <p class="project-name">Garapanku</p>
          <p class="project-desc">Creator donation & support platform. PERN stack.</p>
        </div>
        <div class="project-card">
          <span class="project-tag amber">Embedded · IoT</span>
          <p class="project-name">SPL Monitoring</p>
          <p class="project-desc">Sound pressure level monitoring dashboard. ESP32 + realtime web.</p>
        </div>
        <div class="project-card">
          <span class="project-tag green">Hardware · PCB</span>
          <p class="project-name">PCB Design</p>
          <p class="project-desc">KiCad — schematics to fabrication-ready files.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <p class="section-label">Accessible</p>
      <div class="stack-row" style="margin-bottom: 1.25rem;">
        <span class="pill">ESP32 · C/C++</span>
        <span class="pill">KiCad</span>
        <span class="pill">Fusion 360</span>
        <span class="pill">Python</span>
      </div>
      <p class="section-label">Exploring</p>
      <div class="stack-row">
        <span class="pill">Bare-metal</span>
        <span class="pill">Bootloader</span>
        <span class="pill">Linux internals</span>
        <span class="pill">Android Security</span>
      </div>
    </section>

    <section class="section" id="about">
      <p class="section-label">About</p>
      <div class="about-grid">
        <div>
          <div style="display:flex; gap:2rem; margin-bottom:1.5rem;">
            <div>
              <p class="stat-num">4+</p>
              <p class="stat-label">Years self-taught</p>
            </div>
            <div>
              <p class="stat-num">8+</p>
              <p class="stat-label">Projects shipped</p>
            </div>
          </div>
          <p class="about-bio">Engineering student in Indonesia. I build end-to-end — from PCB schematics to backend APIs. Currently finishing my Tugas Akhir and developing Garapanku.</p>
        </div>
        <div class="divider-left" id="writing">
          <p class="section-label">Writing</p>
          <p class="about-bio">I write analytical essays on technology, political economy, and engineering on <a href="https://medium.com/@hellow0rlddzxz" style="color:var(--accent);">Medium @hellow0rlddzxz</a>.</p>
        </div>
      </div>
    </section>

    <section class="section" id="contact" style="border-bottom:none;">
      <p class="section-label">Get in touch</p>
      <h2>Let's work together.</h2>
      <p class="section-sub">Open for freelance — hardware design, enclosure modeling, and web development.</p>
      <div class="contact-links">
        <a href="https://github.com/alfonsomzrtt" class="contact-link">GitHub</a>
        <a href="https://medium.com/@hellow0rlddzxz" class="contact-link">Medium</a>
        <a href="mailto:your@email.com" class="contact-link">Email</a>
      </div>
    </section>

    <footer>
      <span>© 2026 Alfonso</span>
      <span>Surabaya, Indonesia</span>
    </footer>

    <script>
      const toggle = document.getElementById('themeToggle');
      const root = document.documentElement;

      const saved = localStorage.getItem('theme') || 'light';
      if (saved === 'dark') {
        root.setAttribute('data-theme', 'dark');
        toggle.checked = true;
      }

      toggle.addEventListener('change', () => {
        const isDark = toggle.checked;
        root.setAttribute('data-theme', isDark ? 'dark' : 'light');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>

  </body>
</html>
